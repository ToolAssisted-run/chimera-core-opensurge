{
  "coreName": "opensurge",
  "systemNames": {
    "OpenSurge": "Open Surge Engine"
  },
  "systemId": "OpenSurge",
  "kind": "game",
  "author": "Alexandre Martins (Open Surge Engine, SurgeScript); the Allegro library; Surge the Rabbit's art and music by the Open Surge community; chimera port by Sergio Martin",
  "url": "https://github.com/ToolAssisted-run/chimera-core-opensurge",
  "runsOn": [
    "windows-x86_64",
    "linux-x86_64",
    "macos-x86_64"
  ],
  "deterministic": true,
  "_memory_note": "[sbrk, sealed, invisible, plain, mmap] MiB: the engine's own memory, Allegro's bitmaps and Mesa's textures on the heap; a game of the project's own (its zip, read whole) in sealed memory, read-only after Init and so in no savestate; C++'s and Mesa's larger allocations mmap'd.",
  "memoryLayoutMiB": [
    256,
    256,
    4,
    4,
    512
  ],
  "video": {
    "_comment": "What the engine's OpenGL draws (Mesa's softpipe, compiled into the core): the game's screen, 426x240 times the Resolution setting (1 to 4).",
    "width": 1704,
    "height": 960,
    "virtualWidth": 426,
    "virtualHeight": 240,
    "vsyncNumerator": 60,
    "vsyncDenominator": 1,
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "_comment": "The engine's own mixer (its music, decoded from Ogg Vorbis files, and its sound effects), run for exactly one sixtieth of a second each step: 735 stereo samples at 44100 Hz.",
    "rate": 44100,
    "samplesPerFrame": 735,
    "channels": 2,
    "get": "GetAudio"
  },
  "input": {
    "name": "Open Surge Engine",
    "_comment": "The engine's controls as its default input map has them: the four directions, the action buttons (Fire 1 jumps and confirms, Fire 2 cancels), Start (Fire 3: pause, confirm), Back (Fire 4: back, quit) and the two shoulder buttons (Fire 5 and 6). The engine reads them from the keyboard: the arrows, Space, Left Ctrl, Enter, Escape and the Shift keys.",
    "buttons": [
      "P1 Up",
      "P1 Down",
      "P1 Left",
      "P1 Right",
      "P1 Fire 1",
      "P1 Fire 2",
      "P1 Start",
      "P1 Back",
      "P1 Left Shoulder",
      "P1 Right Shoulder"
    ],
    "mnemonics": {
      "Up": "U",
      "Down": "D",
      "Left": "L",
      "Right": "R",
      "Fire 1": "A",
      "Fire 2": "B",
      "Start": "S",
      "Back": "E",
      "Left Shoulder": "l",
      "Right Shoulder": "r"
    }
  },
  "settings": [
    {
      "name": "startTime",
      "display": "setting.starttime",
      "type": "datetime",
      "default": 1704067200,
      "min": 0,
      "max": 4102444799,
      "description": "setting.starttime.about"
    },
    {
      "name": "resolution",
      "display": "setting.resolution",
      "type": "int",
      "default": 1,
      "min": 1,
      "max": 4,
      "description": "setting.resolution.about"
    },
    {
      "name": "quality",
      "display": "setting.quality",
      "type": "enum",
      "options": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "description": "setting.quality.about",
      "optionLabels": {
        "low": "setting.quality.option.low",
        "medium": "setting.quality.option.medium",
        "high": "setting.quality.option.high"
      }
    },
    {
      "name": "language",
      "display": "setting.language",
      "type": "string",
      "default": "",
      "description": "setting.language.about"
    },
    {
      "name": "startLevel",
      "display": "setting.startlevel",
      "type": "string",
      "default": "",
      "description": "setting.startlevel.about"
    },
    {
      "name": "quest",
      "display": "setting.quest",
      "type": "string",
      "default": "",
      "description": "setting.quest.about"
    }
  ],
  "firmware": []
}
