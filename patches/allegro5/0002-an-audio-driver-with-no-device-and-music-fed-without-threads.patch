diff --git a/addons/audio/kcm_stream.c b/addons/audio/kcm_stream.c
index b17a6670a..adeb701ee 100644
--- a/addons/audio/kcm_stream.c
+++ b/addons/audio/kcm_stream.c
@@ -929,3 +929,123 @@ bool al_set_audio_stream_channel_matrix(ALLEGRO_AUDIO_STREAM *stream, const floa
 }
 
 /* vim: set sts=3 sw=3 et: */
+
+
+/* osmesa: the feeding without a thread. A stream is registered when its
+ * codec starts feeding it; _al_kcm_pump_streams, called by the audio driver
+ * once a step, does what _al_kcm_feed_stream does in its thread: it reads
+ * the stream's events and fills the fragments they say are free. */
+void _al_kcm_feeder_start(ALLEGRO_AUDIO_STREAM *stream);
+void _al_kcm_feeder_stop(ALLEGRO_AUDIO_STREAM *stream);
+void _al_kcm_pump_streams(void);
+#define OSM_MAX_FEEDERS 64
+static ALLEGRO_AUDIO_STREAM *osm_feeders[OSM_MAX_FEEDERS];
+static int osm_feeder_count;
+
+static void osm_feed_event(ALLEGRO_AUDIO_STREAM *stream, ALLEGRO_EVENT *event)
+{
+   if (event->type == ALLEGRO_EVENT_AUDIO_STREAM_FRAGMENT && !stream->is_draining) {
+      unsigned long bytes;
+      unsigned long bytes_written;
+      ALLEGRO_MUTEX *stream_mutex;
+      char *fragment = al_get_audio_stream_fragment(stream);
+      if (!fragment)
+         return;
+
+      bytes = (stream->spl.spl_data.len) *
+            al_get_channel_count(stream->spl.spl_data.chan_conf) *
+            al_get_audio_depth_size(stream->spl.spl_data.depth);
+
+      stream_mutex = maybe_lock_mutex(stream->spl.mutex);
+      bytes_written = stream->feeder(stream, fragment, bytes);
+      maybe_unlock_mutex(stream_mutex);
+
+      if (stream->spl.loop == _ALLEGRO_PLAYMODE_STREAM_ONEDIR) {
+         while (bytes_written < bytes &&
+                  stream->spl.loop == _ALLEGRO_PLAYMODE_STREAM_ONEDIR) {
+            size_t bw;
+            al_rewind_audio_stream(stream);
+            stream_mutex = maybe_lock_mutex(stream->spl.mutex);
+            bw = stream->feeder(stream, fragment + bytes_written, bytes - bytes_written);
+            bytes_written += bw;
+            maybe_unlock_mutex(stream_mutex);
+         }
+      }
+      else if (bytes_written < bytes) {
+         int silence_samples = (bytes - bytes_written) /
+            (al_get_channel_count(stream->spl.spl_data.chan_conf) *
+             al_get_audio_depth_size(stream->spl.spl_data.depth));
+         al_fill_silence(fragment + bytes_written, silence_samples,
+                         stream->spl.spl_data.depth, stream->spl.spl_data.chan_conf);
+      }
+
+      if (!al_set_audio_stream_fragment(stream, fragment)) {
+         ALLEGRO_ERROR("Error setting stream buffer.\n");
+         return;
+      }
+
+      if (bytes_written != bytes &&
+          (stream->spl.loop == _ALLEGRO_PLAYMODE_STREAM_ONCE ||
+           stream->spl.loop == _ALLEGRO_PLAYMODE_STREAM_LOOP_ONCE)) {
+         stream->is_draining = true;
+         if (!stream->feeder_finished_sent) {
+            ALLEGRO_EVENT fin_event;
+            fin_event.user.type = ALLEGRO_EVENT_AUDIO_STREAM_FINISHED;
+            fin_event.user.timestamp = al_get_time();
+            al_emit_user_event(&stream->spl.es, &fin_event, NULL);
+            stream->feeder_finished_sent = true;
+         }
+      } else {
+         stream->feeder_finished_sent = false;
+      }
+   }
+   else if (event->type == _KCM_STREAM_FEEDER_QUIT_EVENT_TYPE) {
+      ALLEGRO_EVENT fin_event;
+      stream->quit_feed_thread = true;
+      fin_event.user.type = ALLEGRO_EVENT_AUDIO_STREAM_FINISHED;
+      fin_event.user.timestamp = al_get_time();
+      al_emit_user_event(&stream->spl.es, &fin_event, NULL);
+   }
+}
+
+static void osm_pump_one(ALLEGRO_AUDIO_STREAM *stream)
+{
+   ALLEGRO_EVENT event;
+   while (stream->feed_queue && al_get_next_event(stream->feed_queue, &event))
+      osm_feed_event(stream, &event);
+}
+
+void _al_kcm_feeder_start(ALLEGRO_AUDIO_STREAM *stream)
+{
+   stream->feed_queue = al_create_event_queue();
+   al_register_event_source(stream->feed_queue, &stream->spl.es);
+   stream->quit_feed_thread = false;
+   stream->feeder_finished_sent = false;
+   if (osm_feeder_count < OSM_MAX_FEEDERS)
+      osm_feeders[osm_feeder_count++] = stream;
+}
+
+void _al_kcm_feeder_stop(ALLEGRO_AUDIO_STREAM *stream)
+{
+   int i;
+   ALLEGRO_EVENT quit_event;
+   quit_event.type = _KCM_STREAM_FEEDER_QUIT_EVENT_TYPE;
+   al_emit_user_event(&stream->spl.es, &quit_event, NULL);
+   osm_pump_one(stream);
+   for (i = 0; i < osm_feeder_count; i++) {
+      if (osm_feeders[i] == stream) {
+         memmove(osm_feeders + i, osm_feeders + i + 1, (osm_feeder_count - i - 1) * sizeof *osm_feeders);
+         osm_feeder_count--;
+         break;
+      }
+   }
+   al_destroy_event_queue(stream->feed_queue);
+   stream->feed_queue = NULL;
+}
+
+void _al_kcm_pump_streams(void)
+{
+   int i;
+   for (i = 0; i < osm_feeder_count; i++)
+      osm_pump_one(osm_feeders[i]);
+}
